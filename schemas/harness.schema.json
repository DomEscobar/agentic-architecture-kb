{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-architect.local/schemas/harness.schema.json",
  "title": "Repository harness binding to canonical knowledge",
  "type": "object",
  "required": ["schema_version", "kb_commit", "because_of", "invariants", "review_at"],
  "properties": {
    "schema_version": {"const": 1},
    "kb_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
    "because_of": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule", "check"],
        "properties": {
          "rule": {"type": "string", "minLength": 10},
          "check": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "review_at": {"type": "string", "format": "date"}
  },
  "additionalProperties": false
}
