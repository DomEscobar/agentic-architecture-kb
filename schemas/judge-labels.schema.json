{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "dataset_sha256", "labelers", "adjudicator", "labels"],
  "properties": {
    "version": {"type": "string"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "labelers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "adjudicator": {"type": "string", "minLength": 2},
    "labels": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["case_id", "labeler_labels", "adjudicated_label", "rationale"], "properties": {"case_id": {"type": "string"}, "labeler_labels": {"type": "object", "minProperties": 2, "additionalProperties": {"enum": ["pass", "fail", "abstain"]}}, "adjudicated_label": {"enum": ["pass", "fail", "exclude"]}, "rationale": {"type": "string", "minLength": 12}}, "additionalProperties": false}}
  },
  "additionalProperties": false
}
