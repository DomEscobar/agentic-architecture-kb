{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-architect.local/schemas/page.schema.json",
  "title": "Agentic Architecture Knowledge Base page metadata",
  "type": "object",
  "required": ["id", "type", "title", "status", "privacy", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
    "type": {"enum": ["source", "concept", "pattern", "case", "entity", "synthesis", "episode", "decision"]},
    "title": {"type": "string", "minLength": 3},
    "status": {"enum": ["inbox", "draft", "reviewed", "contested", "superseded", "archived"]},
    "privacy": {"enum": ["public", "internal", "personal", "restricted"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "review_at": {"type": "string", "format": "date"},
    "source_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["predicate", "target"],
        "properties": {
          "predicate": {"enum": ["supports", "contradicts", "supersedes", "derived_from", "applies_to", "depends_on", "evaluated_by"]},
          "target": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
